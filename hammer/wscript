"""Original Hammer editor DLL, using hammer_dll.vpc source membership."""

def configure(conf):
    if conf.env.COMPILER_CXX != 'msvc':
        conf.fatal('Hammer requires Microsoft Visual C++ and its MFC/ATL component. Use --disable-hammer for a game-only build.')
    conf.env.append_unique('DEFINES', ['VALVE', 'PROTECTED_THINGS_DISABLE',
        'VERSION_SAFE_STEAM_API_INTERFACES', 'NO_WARN_MBCS_MFC_DEPRECATION',
        '_MBCS', '_USRDLL', '_AFX_NO_DAO_SUPPORT', 'NO_MEMOVERRIDE_NEW_DELETE'])
    # Keep the selected /MT CRT and static MBCS MFC, matching the original VPC.
    conf.env.CXXFLAGS = [x for x in conf.env.CXXFLAGS if x not in ('/EHsc', '/EHs')]
    conf.env.append_unique('CXXFLAGS', ['/EHa'])
    conf.check_cxx(fragment='#include <afxwin.h>\nint main() { CPoint p(1, 2); return p.x - 1; }',
        msg='Checking Hammer MFC/ATL headers and static MBCS libraries', mandatory=True)

