#include <windows.h>

1 ICON "..\\launcher\\res\\launcher.ico"
1 RT_MANIFEST "gamma_launcher.manifest"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GammaSource Launcher\0"
            VALUE "FileVersion", "1.0\0"
            VALUE "InternalName", "gamma_launcher\0"
            VALUE "OriginalFilename", "GammaSource Launcher.exe\0"
            VALUE "ProductName", "GammaSource\0"
            VALUE "ProductVersion", "1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
