 	int iFrame;
 
 	flWeight = Studio_IKRuleWeight( *pRule, panim, flCycle, iFrame, fraq );
+	if ( ( panim->flags & STUDIO_GAMMA_LEGACY2003 ) && flWeight >= 0.0001f )
+	{
+		// 2003 error tables use absolute frames and wrap by numframes,
