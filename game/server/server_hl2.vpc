$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"hl2" [!$SOURCESDK]
$Macro GAMENAME 	"mod_hl2" [$SOURCESDK]

$Include "$SRCDIR\game\server\server_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$SRCDIR\game\shared\hl2;.\hl2;$SRCDIR\game\shared\gamma;.\gamma;.\portal;$SRCDIR\game\shared\portal"
		$PreprocessorDefinitions		"$BASE;HL2_DLL;USES_SAVERESTORE;PORTAL;GAMMA_PORTALGUN"
	}
}

