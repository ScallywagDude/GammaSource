	"$basetexture" "gamma_2003/compat_reflective/Decals/shadertest/DecalDarkeningSpecularCubicEnvMap_mask"
	"$decal" 1
	"$decalscale" 0.25
	"$envmaptint" "[ 0.50 0.50 0.50 ]"
}
