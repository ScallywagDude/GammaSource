#! /usr/bin/env python
# encoding: utf-8

def configure(conf):
    return

def build(bld):
    bld.program(name='hammer', target='hammer',
        source=['main.cpp', 'hammer_launcher.rc'],
        includes=['.', '../public', '../public/tier0', '../public/tier1', '../common'],
        use=['appframework', 'tier0', 'tier1', 'tier2', 'tier3', 'vstdlib',
             'USER32', 'SHELL32', 'OLE32', 'ADVAPI32'],
        # All engine/editor DLLs live beside the launcher in bin.
        install_path=bld.env.LIBDIR, subsystem=bld.env.MSVC_SUBSYSTEM,
        idx=bld.get_taskgen_count())
